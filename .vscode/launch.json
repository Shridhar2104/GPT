{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTORCH_ENABLE_MPS_FALLBACK": "1" }
    },
    {
      "name": "Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTORCH_ENABLE_MPS_FALLBACK": "1" }
    }
  ]
}
